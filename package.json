{
  "name": "manarah",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:manarah": "turbo -F web -F server dev",
    "stop:manarah": "pkill -f '[t]urbo -F web -F server dev' || true; lsof -ti:3000,9001 | xargs -r kill || true; sleep 1; lsof -ti:3000,9001 | xargs -r kill -9 || true; echo 'manarah stopped (ports 3000, 9001)'",
    "dev:raqeem": "turbo -F raqeem-backend -F raqeem-frontend dev",
    "build:manarah": "turbo -F web -F server build",
    "build:raqeem": "turbo -F raqeem-backend -F raqeem-frontend build",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F server db:push",
    "db:studio": "turbo -F server db:studio",
    "db:generate": "turbo -F server db:generate",
    "db:migrate": "turbo -F server db:migrate",
    "db:start": "turbo -F server db:start",
    "db:watch": "turbo -F server db:watch",
    "db:stop": "turbo -F server db:stop",
    "db:down": "turbo -F server db:down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vercel/style-guide": "^6.0.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "turbo": "^2.5.6"
  },
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=24"
  }
}
